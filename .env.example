# Write the values without quotes: `docker run --env-file` keeps quotes as part of the value.
# Tinker API key. Needed by every command that samples from or trains a model.
TINKER_API_KEY=
# Base URL of the OpenAI-compatible endpoint of the skill evolver, e.g. https://api.openai.com/v1.
EVOLVER_BASE_URL=
# API key for that endpoint. Needed by `adapt skills`.
EVOLVER_API_KEY=
# Name of the evolver model on that endpoint (the paper used GPT-5.2); there is no default.
EVOLVER_MODEL=
# Hugging Face token. Optional; only needed when a model's tokenizer repository is gated.
HF_TOKEN=
